   <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #f5f7fa;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 15px;
    color: #333;
}
QFrame#topBar {
    background-color: white;
    border-bottom: 1px solid #e1e4e8;
}
QFrame#statCard {
    background-color: white;
    border: 1px solid #e1e4e8;
    border-radius: 6px;
}
QFrame#logFrame {
    background-color: #1e1e1e;
    border-radius: 4px;
}
QPushButton {
    border: none;
    border-radius: 6px;
    padding: 12px 22px;
    font-size: 15px;
    min-height: 44px;
}
QPushButton:focus { outline: none; }
QPushButton#startBtn {
    background-color: #27ae60;
    color: white;
    font-weight: bold;
}
QPushButton#startBtn:hover { background-color: #2ecc71; }
QPushButton#startBtn:disabled { background-color: #95a5a6; }
QPushButton#pauseBtn {
    background-color: #f39c12;
    color: white;
    font-weight: bold;
}
QPushButton#pauseBtn:hover { background-color: #f5b041; }
QPushButton#stopBtn {
    background-color: #e74c3c;
    color: white;
    font-weight: bold;
}
QPushButton#stopBtn:hover { background-color: #ec7063; }
QPushButton#openPlanBtn {
    background-color: #2c5aa0;
    color: white;
}
QPushButton#openPlanBtn:hover { background-color: #3a6bb8; }
QPushButton#resetBtn {
    background-color: #95a5a6;
    color: white;
}
QPushButton#resetBtn:hover { background-color: #aab7b8; }
QPushButton#logToggleBtn {
    background-color: #34495e;
    color: white;
}
QTreeWidget {
    background-color: white;
    border: 1px solid #e1e4e8;
    border-radius: 4px;
    alternate-background-color: #f8f9fa;
}
QTreeWidget::item {
    padding: 9px 16px;
    height: 42px;
}
QTextEdit#logText {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}
QLabel#statValue {
    font-size: 26px;
    font-weight: bold;
}
QLabel#statLabel {
    font-size: 13px;
    color: #7f8c8d;
}
QLineEdit {
    padding: 11px 12px;
    border: 1px solid #d0d7de;
    border-radius: 4px;
    background-color: white;
    font-size: 15px;
}
QComboBox {
    padding: 11px 12px;
    border: 1px solid #d0d7de;
    border-radius: 4px;
    background-color: white;
    font-size: 15px;
}
QGroupBox {
    font-weight: bold;
    font-size: 15px;
    padding-top: 14px;
}
QHeaderView::section {
    font-size: 14px;
    padding: 8px;
}</string>

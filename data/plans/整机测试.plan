{
  "name": "整机测试",
  "description": "整机测试：主站/使能/运控启动 → 手臂小角度 → 头部 → 腰部 → 腰部升降柱 → 手臂基本信息/测试项（从机械臂分装线计划复制 15050~15440）→ 收尾。手臂复制项中 15010/15020/15030/15040/15085 与整机前置或 20010 重复，未重复复制。头部左右/上下使用极限值 (yaw ±1.57 rad, pitch +0.695/-0.52 rad)，最后归零；腰部角度以「度」输入，脚本转弧度，硬限制 10°。脚本会读取 joint_states 的 name 自动识别 yaw/pitch 下标，不依赖 head_joints/waist_joints 的固定顺序；默认按 controllers_config.yaml 的 [yaw, pitch] 兜底。",
  "variables": {
    "head_speed": {
      "type": "float",
      "value": 0.5,
      "description": "头部运控速度 0~1"
    },
    "waist_angle_deg": {
      "type": "float",
      "value": 5.0,
      "description": "腰部测试角度（度），默认 5°，脚本硬限制 ≤10°"
    },
    "waist_speed": {
      "type": "float",
      "value": 0.3,
      "description": "腰部运控速度 0~1"
    },
    "lift_up_position": {
      "type": "int",
      "value": 80,
      "description": "升降柱上升位值（0~2000）"
    },
    "lift_down_position": {
      "type": "int",
      "value": 0,
      "description": "升降柱回零位值"
    },
    "lift_speed": {
      "type": "int",
      "value": 80,
      "description": "升降柱速度（0~200）"
    },
    "lift_wait_s": {
      "type": "float",
      "value": 12.0,
      "description": "升降柱每条指令后的等待时间（秒）"
    }
  },
  "settings": {
    "storage_mode": "local",
    "batch": "",
    "log_dir": "",
    "report_dir": "",
    "continuous": false,
    "remote_storage_enabled": false,
    "remote_storage_url": "",
    "remote_storage_content": "both",
    "remote_storage_strategy": "always",
    "json_upload_enabled": false,
    "json_upload_url": "",
    "json_upload_key": "",
    "series_id": "",
    "is_final": false,
    "server_username": "root",
    "server_password": "root",
    "mes_server": "",
    "mes_interface": "",
    "mes_template": "",
    "remote_file_server": "",
    "remote_db_ip": "",
    "remote_db_table": "",
    "login_url": "",
    "login_username": "",
    "login_password": "",
    "token_header": "Authorization",
    "token_prefix": "Bearer "
  },
  "sequences": [

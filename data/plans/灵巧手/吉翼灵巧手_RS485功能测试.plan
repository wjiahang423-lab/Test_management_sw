{
  "name": "吉翼灵巧手_RS485功能测试",
  "description": "吉翼灵巧手 RS485 功能测试（USB-485）。测量类读取并判定；写类判定 ok==1。连接默认：port=/dev/ttyUSB0, baud=1Mbps, dev_id=0x20。可按需修改。",
  "variables": {},
  "settings": {
    "storage_mode": "local",
    "batch": "",
    "log_dir": "",
    "report_dir": "",
    "remote_storage_enabled": false,
    "remote_storage_url": "",
    "json_upload_enabled": false,
    "json_upload_url": "",
    "json_upload_key": "",
    "server_username": "root",
    "server_password": "root",
    "mes_server": "",
    "mes_interface": "",
    "mes_template": "",
    "remote_file_server": "",
    "remote_db_ip": "",
    "remote_db_table": ""
  },
  "sequences": [
    {
      "id": "c586336472594f07b0a3a0faec1664e8",
      "name": "读类功能测试(R)",
      "cases": [
        {
          "id": "7f9f0b64ce4e433a8b81bf82c38a40a9",
          "name": "测量_产品信息",
          "type": "measurement",
          "timeout_ms": 10000,
          "retry": 0,
          "fail_policy": "continue",
          "skip": false,
          "description": "0x00 读产品信息（R）",
          "config": {
            "display": "产品信息",
            "script": "scripts/灵巧手/rs485_test.py",
            "function": "mea_read_info",
            "params": [
              {
                "name": "port",
                "type": "str",
                "value": "/dev/ttyUSB0",
                "source": "value"
              },
              {
                "name": "baud",
                "type": "int",
                "value": 1000000,
                "source": "value"
              },
              {
                "name": "dev_id",
                "type": "int",
                "value": 32,
                "source": "value"
              }
            ],
            "returns": [
              {
                "item": "value",
                "type": "int",
                "bind_var": "",
                "judge": "不等于",
                "threshold": "0",
                "display": "产品信息"
              }
            ]
          }
        },

    "remote_db_table": ""
  },
  "sequences": [
    {
      "id": "apiseq000001",
      "name": "001_接口指令测试(HTTP)",
      "cases": [
        {
          "id": "apicase000001",
          "name": "001_板卡接口list/describe",
          "type": "loop",
          "timeout_ms": 5000,
          "retry": 0,
          "fail_policy": "continue",
          "skip": true,
          "description": "robot_test_001：发送 list/describe 指令，判定 code==0、msg==ok",
          "config": {
            "yaml_path": "scripts/demo_items.yaml",
            "script": "scripts/demo_instrument.py",
            "function": "robot_test_001",
            "parser": "robot_test_001",
            "session_key": "list_describe_request",
            "overrides": []
          }
        }
      ]
    },
    {
      "id": "bd7b6479ef9e",
      "name": "标定确认_rviz2",
      "cases": [
        {
          "id": "4023f3edf60d",
          "name": "Test1_打开验证视图",
          "type": "action",
          "timeout_ms": 15000,
          "retry": 0,
          "fail_policy": "continue",
          "skip": false,
          "description": "标定完成后弹出 RViz2 验证视图，展示雷达/相机轮廓",
          "config": {

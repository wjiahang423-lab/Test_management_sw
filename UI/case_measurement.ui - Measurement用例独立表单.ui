}
QLabel#hintLabel {
    color: #7f8c8d;
    font-style: italic;
    padding: 6px;
    background-color: #f8f9fa;
    border-radius: 4px;
}
QGroupBox {
    border: 1px solid #e1e4e8;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    font-weight: bold;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    padding: 6px 10px;
    border: 1px solid #d0d7de;
    border-radius: 4px;
    background-color: white;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2c5aa0;
}
QPushButton {
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
    background-color: #2c5aa0;
    color: white;
}
QPushButton:hover { background-color: #3a6bb8; }
QPushButton#btn_loadFunc { background-color: #27ae60; }
QPushButton#btn_loadFunc:hover { background-color: #2ecc71; }
QTableWidget {
    border: 1px solid #e1e4e8;
    border-radius: 4px;
    gridline-color: #e1e4e8;
}
QHeaderView::section {
    background-color: #f8f9fa;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #e1e4e8;
    font-weight: bold;
}</string>

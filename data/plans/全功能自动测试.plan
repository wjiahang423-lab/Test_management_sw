  "variables": {
    "pop_a": {
      "type": "str",
      "value": true,
      "description": "弹窗结果A"
    },
    "pop_b": {
      "type": "str",
      "value": true,
      "description": "弹窗结果B"
    },
    "pop_c": {
      "type": "str",
      "value": true,
      "description": "弹窗结果C"
    }
  },

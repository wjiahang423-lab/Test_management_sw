        <property name="plainText">
         <string># 格式一：扁平式（整条即数据，函数自行判定，如 measure(params)）
items:
  - name: "温度_正常值"
    value: 25.0
    unit: "°C"
    min_val: 20.0
    max_val: 30.0

# 格式二：包装式（input 入参 + expected 期望值逐项判定）
sessions:
  - name: "测试点1"
    input: {voltage: 12.0, current: 1.5}
    expected: {result: "pass", max_temp: 60}
  - name: "测试点2"
    input: {voltage: 14.0, current: 2.0}
    expected: {result: "pass", max_temp: 70}</string>

{
  "name": "吉翼灵巧手_CANFD功能测试",
  "description": "吉翼灵巧手 CANFD 功能测试（ZLG USB-CANFD-200U）。测量类：读取寄存器并数值判定；写类：判定 value/ok。CAN 连接参数（dev_id/channel/interface/bitrate/等）统一在 scripts/灵巧手/canfd_test.py 顶部「公共全局前置参数设置」中配置，PLAN 仅传测量/写入数据参数。",
  "variables": {},
  "settings": {
    "storage_mode": "local",
    "batch": "",
    "log_dir": "",
    "report_dir": "",
    "remote_storage_enabled": false,
    "remote_storage_url": "",
    "json_upload_enabled": false,
    "json_upload_url": "",
    "json_upload_key": "",
    "server_username": "root",
    "server_password": "root",
    "mes_server": "",
    "mes_interface": "",
    "mes_template": "",
    "remote_file_server": "",
    "remote_db_ip": "",
    "remote_db_table": ""
  },

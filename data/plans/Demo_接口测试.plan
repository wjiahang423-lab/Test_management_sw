            "function": "open_rviz_view",
            "description": ""
          }
        },
        {
          "id": "4023f3edf610",
          "name": "Test2_查看截图并保存",
          "type": "action",
          "timeout_ms": 60000,
          "retry": 0,
          "fail_policy": "continue",
          "skip": false,
          "description": "等待操作员确认轮廓重合后截图存档、保存外参 JSON 并自动关闭",
          "config": {
            "script": "scripts/地盘标定/calib_rviz.py",
            "function": "verify_and_save",
            "description": ""
          }
        }
      ]
    }
  ]

}
QListWidget#navList {
    background-color: #2c3e50;
    border: none;
    color: #ecf0f1;
    font-size: 14px;
    outline: none;
}
QListWidget#navList::item {
    padding: 12px 16px;
    border-left: 3px solid transparent;
}
QListWidget#navList::item:hover {
    background-color: #34495e;
}
QListWidget#navList::item:selected {
    background-color: #34495e;
    border-left: 3px solid #3498db;
    color: white;
}
QFrame#topBar {
    background-color: white;
    border-bottom: 1px solid #e1e4e8;
}
QPushButton {
    border: none;
    border-radius: 4px;
    padding: 7px 14px;
    font-size: 13px;
}
QPushButton#btn_newPlan { background-color: #27ae60; color: white; }
QPushButton#btn_newPlan:hover { background-color: #2ecc71; }
QPushButton#btn_openPlan { background-color: #2c5aa0; color: white; }
QPushButton#btn_openPlan:hover { background-color: #3a6bb8; }
QPushButton#btn_savePlan { background-color: #f39c12; color: white; }
QPushButton#btn_savePlan:hover { background-color: #f5b041; }
QPushButton#btn_saveAs { background-color: #16a085; color: white; }
QPushButton#btn_saveAs:hover { background-color: #1abc9c; }
QPushButton#btn_deletePlan { background-color: #e74c3c; color: white; }
QPushButton#btn_deletePlan:hover { background-color: #ec7063; }
QPushButton#btn_planSettings { background-color: #8e44ad; color: white; }
QPushButton#btn_planSettings:hover { background-color: #9b59b6; }
QPushButton#btn_addSeq { background-color: #3498db; color: white; }
QPushButton#btn_addSeq:hover { background-color: #5dade2; }
QPushButton#btn_addCase { background-color: #3498db; color: white; }
QPushButton#btn_addCase:hover { background-color: #5dade2; }
QPushButton#btn_editItem { background-color: #95a5a6; color: white; }
QPushButton#btn_editItem:hover { background-color: #aab7b8; }
QPushButton#btn_deleteItem { background-color: #e74c3c; color: white; }
QPushButton#btn_deleteItem:hover { background-color: #ec7063; }
QTreeWidget {
    background-color: white;
    border: 1px solid #e1e4e8;
    border-radius: 14px;
    alternate-background-color: #f8f9fa;
}
QTreeWidget::item {
    padding: 4px 16px;
    height: 34px;
}
QGroupBox {
    background-color: white;
    border: 1px solid #e1e4e8;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    font-weight: bold;
}
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit {
    padding: 6px 10px;
    border: 1px solid #d0d7de;
    border-radius: 4px;
    background-color: white;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2c5aa0;
}
QTableWidget {
    background-color: white;
    border: 1px solid #e1e4e8;
    border-radius: 4px;
    gridline-color: #e1e4e8;
}
QHeaderView::section {
    background-color: #f8f9fa;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #e1e4e8;
    font-weight: bold;
}</string>
